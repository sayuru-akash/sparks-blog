# Ghost CMS Configuration
# Get these values from your Ghost CMS admin panel
# Navigate to: Settings → Integrations → Custom Integrations

# Your Ghost CMS instance URL (include https://)
GHOST_URL=https://your-ghost-instance.com

# Ghost Content API Key
CONTENT_KEY=your-ghost-content-api-key-here

# Optional: Site URL for metadata generation
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ============================================
# HOW TO GET YOUR GHOST CMS CREDENTIALS:
# ============================================
#
# 1. Log in to your Ghost CMS admin panel
# 2. Navigate to Settings → Integrations
# 3. Click "Add Integration" under "Custom Integrations"
# 4. Give it a name (e.g., "Sparks Blog")
# 5. Copy the "Content API Key" and paste it below as CONTENT_KEY
# 6. Use your Ghost instance URL as GHOST_URL
#    Examples:
#    - Ghost(Pro): https://your-blog.ghost.io
#    - Self-hosted: https://blog.yourdomain.com
#
# ============================================
# IMPORTANT NOTES:
# ============================================
#
# - Never commit this file with real credentials to version control
# - This file should be renamed to .env.local for local development
# - For production, set these variables in your hosting platform's dashboard
# - The CONTENT_KEY is for the Content API (read-only), not Admin API
#
# ============================================
